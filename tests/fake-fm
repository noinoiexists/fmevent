#!/bin/sh
#
# A stand-in for /usr/bin/fm, for tests that must not depend on the model.
#
# It reads stdin exactly the way fm does, so the plumbing under test is real;
# only the answer is synthetic. Behaviour is driven by FAKE_FM_MODE:
#
#   ok           (default) emit FAKE_FM_* as a verdict or routing object
#   malformed    emit prose instead of JSON
#   nofields     emit JSON that is missing the required fields
#   license      exit 69, as fm does when the licence has not been agreed
#   unavailable  exit 1 with the modelNotReady message
#   empty        exit 0 having printed nothing
#   hang         never answer, to exercise the watchdog
#
# For route mode set FAKE_FM_MODE=ok and FAKE_FM_MATCHES to a raw JSON array
# body, e.g. FAKE_FM_MATCHES='"dependency","nonsense"'.

payload=$(cat 2>/dev/null)

mode=${FAKE_FM_MODE:-ok}

case "$mode" in
    license)
        printf 'You have not agreed to these terms. Exiting.\n' >&2
        exit 69
        ;;
    unavailable)
        printf 'Error: The model is not available. Try again later.\n' >&2
        exit 1
        ;;
    malformed)
        printf 'Sure! Based on the text, the answer is yes.\n'
        exit 0
        ;;
    nofields)
        printf '{"something":"else"}\n'
        exit 0
        ;;
    empty)
        exit 0
        ;;
    ctrljson)
        # Right shape, illegal JSON: a raw BEL and a literal newline inside a
        # string. Constrained decoding can produce this when it quotes a control
        # character out of the input, and fmevent repairs it rather than failing.
        printf '{"evidence":"a\007raw\nbell","matched":true,"confidence":1}\n'
        exit 0
        ;;
    echo-payload)
        # Echo the payload back as the evidence, so a test can assert on what
        # actually reached the model after sanitisation.
        printf '{"evidence":"%s","matched":true,"confidence":1}\n' \
            "$(printf '%s' "$payload" | tr -d '\n\r"\\')"
        exit 0
        ;;
    hang)
        sleep 60
        exit 0
        ;;
esac

evidence=${FAKE_FM_EVIDENCE:-a fake quotation}
confidence=${FAKE_FM_CONFIDENCE:-0.9}

if [ -n "${FAKE_FM_MATCHES:-}" ]; then
    printf '{"evidence":"%s","matches":[%s],"confidence":%s}\n' \
        "$evidence" "$FAKE_FM_MATCHES" "$confidence"
else
    printf '{"evidence":"%s","matched":%s,"confidence":%s}\n' \
        "$evidence" "${FAKE_FM_MATCHED:-true}" "$confidence"
fi
exit 0
